# Credenciais usadas pelo container do Postgres (docker-compose.yml)
POSTGRES_USER=viajajunto
POSTGRES_PASSWORD=viajajunto
POSTGRES_DB=viajajunto
POSTGRES_PORT=5432

# URL usada pela aplicação (SQLAlchemy) para conectar no banco acima.
# Host "localhost" porque a API roda fora do Docker, direto na máquina.
DATABASE_URL=postgresql+psycopg2://viajajunto:viajajunto@localhost:5432/viajajunto

# Ambiente da aplicação: development, test ou production (ou outro nome).
# Fora de development/test a API só sobe com uma JWT_SECRET_KEY própria.
APP_ENV=development

# Chave usada para assinar/validar os tokens JWT (PyJWT). Em development/test,
# se ficar vazia, usa-se a chave de exemplo. Fora disso é obrigatória, precisa
# ter pelo menos 32 bytes e não pode ser a chave de exemplo. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-super-secret-key-dev-only

# Tempo de expiração do access token, em minutos.
JWT_EXPIRE_MINUTES=60

# Cache opcional fora do Docker (vazio = desativado).
REDIS_URL=
CACHE_TTL_SECONDS=60

# Banco exclusivo dos testes (serviço db_test do docker-compose, profile "test").
# O nome precisa terminar em "_test"; o pytest recusa qualquer outro banco.
TEST_DATABASE_URL=postgresql+psycopg2://viajajunto:viajajunto@localhost:5433/viajajunto_test

# Envio de email (recuperação de senha). "console" escreve o email no log da API
# (só desenvolvimento: o log passa a conter o link); "smtp" envia de verdade.
# No Docker Compose a API já usa smtp apontando para o Mailpit (http://localhost:8025).
# Para a API fora do Docker usar o Mailpit: EMAIL_BACKEND=smtp e SMTP_HOST=localhost.
EMAIL_BACKEND=console
EMAIL_REMETENTE=ViajaJunto <nao-responda@viajajunto.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=false

# Página do frontend que recebe ?token=... e pede a nova senha.
RECUPERACAO_SENHA_URL=http://localhost:3000/redefinir-senha

# Apenas o catálogo de exemplo se estiver vazio; não desativa o seed completo.
# O Compose executa o seed completo automaticamente quando APP_ENV=development.
SEED_CATALOGO=true
